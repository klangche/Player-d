# Player-d stack settings. Docker Compose: copy to `.env`.
# Portainer: enter the same names under "Environment variables"
# (or use "Load variables from .env file").
# All are optional; the values shown are the defaults.

# Image tag for every service. `latest` follows the newest release.
PLAYERD_TAG=latest

# Web GUI port.
PLAYERD_HTTP_PORT=8080

# Host name published via mDNS: <zone>.<PLAYERD_HOSTNAME>.local.
PLAYERD_HOSTNAME=player-d

# Network interface connected to the Dante network.
PLAYERD_DANTE_NIC=eth0

# Dante sample rate: 48000 or 96000.
PLAYERD_SAMPLE_RATE=48000

# Data location: player-d-data (the default named volume) or an absolute
# host path such as /opt/player-d. Other volume names and relative paths
# are not supported.
PLAYERD_DATA=player-d-data

# Optional license key text. Can also be imported in Settings.
PLAYERD_LICENSE=

# Set to true and redeploy to print a new admin password in the log.
# Set back to false after logging in: while true, every start (including
# a host reboot) prints a new password and the previous one stops working.
PLAYERD_RESET_PASSWORD=false

TZ=Etc/UTC
